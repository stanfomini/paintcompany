APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
LIVEWIRE_TEMPORARY_FILE_UPLOAD_DISK=local
QUEUE_CONNECTION=database

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=mailgun
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Mailgun Configuration
MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.mailgun.net

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Photo Storage (Wasabi/S3)
PHOTOS_DISK=public
PHOTOS_DISK_DRIVER=local
PHOTOS_AWS_ACCESS_KEY_ID=
PHOTOS_AWS_SECRET_ACCESS_KEY=
PHOTOS_AWS_DEFAULT_REGION=us-east-1
PHOTOS_AWS_BUCKET=apex-photos
PHOTOS_AWS_ENDPOINT=https://s3.us-east-1.wasabisys.com
PHOTOS_AWS_USE_PATH_STYLE_ENDPOINT=true
PHOTO_MAX_SIZE_MB=15

# Python Service Configuration
PYTHON_ENABLED=false
PYTHON_SERVICE_URL=http://127.0.0.1:8000
PYTHON_SERVICE_TIMEOUT=60
PYTHON_RETRY_ATTEMPTS=3
PYTHON_API_KEY=  # Generate with: php -r "echo bin2hex(random_bytes(32));"

# ML Configuration
ML_MODELS_PATH=
ML_GPU_ENABLED=false

# Scraping Configuration
SCRAPING_PROXY_URL=
SCRAPING_RATE_LIMIT=10
SCRAPING_TIMEOUT=120

# Media Configuration
RTMP_SERVER_URL=rtmp://127.0.0.1:1935
HLS_OUTPUT_PATH=/var/www/hls
WHISPER_MODEL=base

VITE_APP_NAME="${APP_NAME}"

# Stripe Configuration
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Increase Configuration
INCREASE_CLIENT_ID=
INCREASE_CLIENT_SECRET=
INCREASE_WEBHOOK_SECRET=
INCREASE_ENVIRONMENT=sandbox

# NativePHP Mobile
NATIVEPHP_APP_VERSION=1.0.0
NATIVEPHP_APP_VERSION_CODE=1
NATIVEPHP_APP_ID=com.apexnegotiations.app
NATIVEPHP_DEEPLINK_SCHEME=apex
NATIVEPHP_START_URL=/
